# Copier ce fichier en .env puis adapter si besoin

# --- Docker compose : ports côté PC ---
DB_PORT=5433
API_PORT=8000
UI_PORT=8501

# --- Modèle Ollama (3b = léger, ~2 Go ; 7b = meilleur, ~5 Go de RAM) ---
OLLAMA_MODEL=qwen2.5-coder:3b

# --- Lancement de l'API hors Docker (développement) ---
DATABASE_URL=postgresql://agent_ro:agent_ro@localhost:5433/shop
OLLAMA_URL=http://localhost:11434
TOP_N=10
