# Copier ce fichier en .env puis adapter si besoin.
# Toutes les lignes sont facultatives : sans .env, les valeurs par défaut s'appliquent.

# --- Ports côté PC ---
DB_PORT=5433
API_PORT=8000
UI_PORT=8501

# --- Modèle Ollama (1.5b ≈ 1 Go, 3b ≈ 2 Go, 7b ≈ 5 Go de RAM) ---
OLLAMA_MODEL=qwen2.5-coder:3b

# --- Où se trouve Ollama ? ---
# Option A (tout dans Docker, lancer avec --profile ollama) : laisser commenté.
# Option B (Ollama installé sur le PC) : décommenter la ligne suivante.
# OLLAMA_URL=http://host.docker.internal:11434
